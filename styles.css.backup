:root {
  color-scheme: dark;
  --bg: #11100f;
  --text: #f4efe6;
  --muted: #b8ac9b;
  --gold: #d9b45f;
  --aqua: #50c7b0;
  --rust: #b35c35;
  --ink: #11100f;
}

* {
  box-sizing: border-box;
}

html,
body {
  height: 100%;
}

body {
  margin: 0;
  min-height: 100%;
  overflow: hidden;
  background: #080807;
  color: var(--text);
  font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Noto Sans TC", sans-serif;
}

button {
  font: inherit;
}

.phone {
  position: relative;
  width: min(100vw, 520px);
  height: 100svh;
  min-height: 620px;
  margin: 0 auto;
  overflow: hidden;
  background: var(--bg);
  touch-action: none;
  isolation: isolate;
}

.scene {
  position: absolute;
  inset: 0;
  display: grid;
  align-content: end;
  padding: 32px 22px 82px;
  opacity: 0;
  pointer-events: none;
  transform: translateY(16px);
  transition: opacity 420ms ease, transform 420ms ease;
}

.scene.active {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.scene-copy {
  position: relative;
  z-index: 5;
  max-width: 330px;
  text-shadow: 0 1px 16px rgba(0, 0, 0, 0.45);
}

h1,
h2,
p {
  margin: 0;
}

h1,
h2 {
  font-size: clamp(34px, 8vw, 52px);
  line-height: 1.02;
  letter-spacing: 0;
}

p {
  margin-top: 12px;
  color: var(--muted);
  font-size: 18px;
}

.gesture {
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: max(18px, env(safe-area-inset-bottom));
  z-index: 20;
  min-height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(244, 239, 230, 0.22);
  border-radius: 8px;
  background: rgba(14, 13, 12, 0.78);
  color: #fff8ea;
  font-size: 15px;
  backdrop-filter: blur(8px);
}

.hud {
  position: absolute;
  top: max(14px, env(safe-area-inset-top));
  left: 16px;
  right: 16px;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  pointer-events: none;
}

.progress {
  display: flex;
  gap: 8px;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(244, 239, 230, 0.28);
}

.dot.active {
  background: var(--gold);
}

#restart {
  pointer-events: auto;
  border: 1px solid rgba(244, 239, 230, 0.24);
  border-radius: 8px;
  background: rgba(17, 16, 15, 0.64);
  color: var(--text);
  min-height: 36px;
  padding: 0 12px;
}

.chip-notice {
  position: absolute;
  top: 72px;
  left: 50%;
  z-index: 80;
  transform: translateX(-50%);
  padding: 10px 14px;
  border-radius: 8px;
  background: #f1d590;
  color: #17110b;
  font-weight: 700;
}

.water {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 86% 24%, rgba(255, 237, 177, 0.82) 0 10%, transparent 27%),
    linear-gradient(160deg, rgba(255, 214, 145, 0.58), transparent 36%),
    linear-gradient(#d79259 0 19%, #b37a57 20% 27%, #667347 28% 34%, #937354 35% 40%, #7ea0a3 41% 56%, #364a4c 57% 100%);
  overflow: hidden;
}

.water::before {
  content: "";
  position: absolute;
  left: -12%;
  right: -12%;
  top: 39%;
  height: 30%;
  background:
    repeating-linear-gradient(168deg, rgba(255, 231, 178, 0.34) 0 2px, transparent 2px 26px),
    repeating-linear-gradient(8deg, rgba(24, 47, 53, 0.32) 0 1px, transparent 1px 34px),
    linear-gradient(180deg, rgba(183, 217, 205, 0.56), rgba(51, 92, 98, 0.76));
  border-top: 3px solid rgba(35, 42, 40, 0.72);
  animation: waterMove 9s linear infinite;
}

.water::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
  background:
    linear-gradient(104deg, transparent 8%, rgba(255, 241, 207, 0.34) 9% 10%, transparent 11% 20%, rgba(255, 241, 207, 0.22) 21% 22%, transparent 23%),
    repeating-linear-gradient(173deg, transparent 0 42px, rgba(28, 31, 31, 0.28) 42px 44px, transparent 44px 90px);
  mix-blend-mode: multiply;
  opacity: 0.62;
}

.bridge {
  position: absolute;
  left: 10%;
  right: -12%;
  top: 17%;
  height: 58px;
  transform: skewY(-4deg);
  background:
    repeating-linear-gradient(90deg, transparent 0 36px, rgba(37, 27, 24, 0.36) 36px 38px),
    linear-gradient(#bd6250, #74352f);
  border: 3px solid #1f2324;
  border-left: 0;
  box-shadow: 0 12px 0 rgba(71, 52, 44, 0.22);
}

.bridge::before,
.bridge::after {
  content: "";
  position: absolute;
  top: 50px;
  width: 28px;
  height: 145px;
  background: linear-gradient(90deg, #4a4038, #c6ad84 15% 80%, #473d38);
  border: 3px solid #202224;
  border-top: 0;
}

.bridge::before {
  left: 22%;
}

.bridge::after {
  right: 20%;
}

.shoreline {
  position: absolute;
  left: -8%;
  right: 28%;
  top: 27%;
  height: 16%;
  background:
    radial-gradient(circle at 10% 64%, #26311f 0 19px, transparent 20px),
    radial-gradient(circle at 12% 62%, #6d7545 0 22px, transparent 23px),
    radial-gradient(circle at 28% 30%, #9a8c4b 0 31px, transparent 32px),
    radial-gradient(circle at 48% 66%, #55613b 0 35px, transparent 36px),
    radial-gradient(circle at 72% 40%, #a18851 0 33px, transparent 34px);
  opacity: 0.88;
  filter: drop-shadow(0 3px 0 rgba(24, 27, 22, 0.58));
}

.tetrapods {
  position: absolute;
  left: -4%;
  right: 18%;
  top: 39%;
  height: 52px;
  background:
    repeating-linear-gradient(145deg, #d0aa7b 0 15px, #58483b 15px 18px, #9b7a5a 18px 28px, transparent 28px 42px),
    repeating-linear-gradient(35deg, transparent 0 17px, rgba(35, 32, 30, 0.72) 17px 20px, transparent 20px 40px);
  clip-path: polygon(0 44%, 100% 0, 100% 72%, 0 100%);
  filter: drop-shadow(0 2px 0 #252322);
}

.anomaly-ripples {
  position: absolute;
  left: 51%;
  top: 45%;
  width: 170px;
  height: 110px;
  transform: translate(-50%, -50%) rotate(-8deg);
  opacity: 0;
  transition: opacity 240ms ease;
}

.anomaly-ripples span {
  position: absolute;
  inset: 28%;
  border: 3px solid rgba(255, 74, 63, 0.84);
  border-radius: 50%;
  filter: drop-shadow(0 0 8px rgba(255, 46, 42, 0.72));
}

.river-found .anomaly-ripples {
  opacity: 1;
}

.river-found .anomaly-ripples span {
  animation: abnormalRipple 1.35s ease-out infinite;
}

.anomaly-ripples span:nth-child(2) {
  animation-delay: 180ms;
}

.anomaly-ripples span:nth-child(3) {
  animation-delay: 360ms;
}

.cabin-frame {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background:
    linear-gradient(86deg, transparent 0 7%, #191b1d 7% 9%, #4a4944 9% 10%, transparent 10% 41%, #17191b 41% 44%, #5b574f 44% 45%, transparent 45% 75%, #17191b 75% 78%, #57534d 78% 79%, transparent 79% 100%),
    linear-gradient(180deg, #171819 0 2%, #57534c 2% 6%, transparent 6% 59%, #1e2020 59% 61%, #59554e 61% 100%);
}

.cabin-frame::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 50% 53%, transparent 0 34%, rgba(0, 0, 0, 0.18) 63%, rgba(0, 0, 0, 0.52) 100%),
    repeating-linear-gradient(104deg, transparent 0 28px, rgba(17, 19, 20, 0.18) 28px 30px, transparent 30px 74px);
  mix-blend-mode: multiply;
}

.window {
  position: absolute;
  top: 7%;
  height: 43%;
  border: 5px solid #181b1d;
  border-radius: 22px;
  background: rgba(255, 224, 166, 0.06);
  box-shadow:
    inset 0 0 0 2px rgba(238, 220, 185, 0.24),
    inset 18px 0 24px rgba(255, 229, 184, 0.14),
    0 0 0 8px rgba(55, 53, 49, 0.95),
    0 2px 0 #111;
}

.window-left {
  left: 4%;
  width: 33%;
  transform: skewX(-8deg);
}

.window-center {
  left: 42%;
  width: 31%;
  transform: skewX(-3deg);
}

.window-right {
  right: 4%;
  width: 20%;
  transform: skewX(7deg);
}

.sample-rack {
  position: absolute;
  left: 4%;
  bottom: 25%;
  z-index: 4;
  display: flex;
  gap: 8px;
  padding: 8px 10px 12px;
  border: 3px solid #1c1f20;
  border-radius: 6px;
  background: linear-gradient(#d6bd89, #866b4f);
  transform: rotate(-5deg);
  box-shadow: 0 10px 0 rgba(28, 27, 25, 0.28);
}

.sample-rack span {
  position: relative;
  width: 34px;
  height: 72px;
  border: 3px solid #1d252b;
  border-radius: 8px 8px 12px 12px;
  background:
    linear-gradient(#304b7d 0 9px, #17222f 9px 11px, transparent 11px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.8) 0 22%, transparent 23%),
    linear-gradient(180deg, #fff6dc, rgba(212, 230, 226, 0.54) 58%, rgba(98, 142, 145, 0.34));
}

.sample-rack span::after {
  content: attr(data-label);
  position: absolute;
  left: 50%;
  top: 36px;
  transform: translateX(-50%) rotate(-7deg);
  color: #151515;
  font-size: 8px;
  font-weight: 900;
  white-space: nowrap;
}

.console-map {
  position: absolute;
  left: 34%;
  bottom: 27%;
  z-index: 4;
  width: 150px;
  height: 94px;
  border: 5px solid #171b1f;
  border-radius: 8px;
  background: linear-gradient(145deg, #394047, #222a30);
  box-shadow: 0 10px 0 rgba(12, 13, 12, 0.36), inset 0 0 0 2px rgba(233, 220, 186, 0.08);
}

.map-shape {
  position: absolute;
  inset: 12px 38px 12px 14px;
  background:
    linear-gradient(130deg, transparent 0 38%, rgba(31, 42, 48, 0.8) 38% 40%, transparent 40%),
    radial-gradient(circle at 62% 22%, #cf3d35 0 3px, transparent 4px),
    radial-gradient(circle at 50% 58%, #cf3d35 0 3px, transparent 4px),
    radial-gradient(circle at 78% 72%, #cf3d35 0 3px, transparent 4px),
    linear-gradient(135deg, #d8d68c 0 42%, #9ed4d8 43% 100%);
}

.console-map i {
  position: absolute;
  right: 10px;
  width: 24px;
  height: 8px;
  border-radius: 8px;
  background: #cfe0d0;
}

.console-map i:nth-of-type(1) {
  top: 16px;
}

.console-map i:nth-of-type(2) {
  top: 34px;
}

.console-map i:nth-of-type(3) {
  top: 52px;
}

.scan-ui {
  position: absolute;
  top: 53%;
  left: 50%;
  z-index: 8;
  width: 138px;
  height: 232px;
  transform: translate(-50%, -50%) rotate(1deg);
  border: 6px solid #18212a;
  border-radius: 18px;
  background:
    linear-gradient(102deg, rgba(255, 255, 255, 0.12) 0 15%, transparent 16%),
    linear-gradient(#5c6470, #25313c);
  box-shadow:
    0 18px 26px rgba(0, 0, 0, 0.4),
    inset 0 0 0 2px rgba(255, 242, 210, 0.09);
  overflow: hidden;
}

.scan-ui::before,
.scan-ui::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.scan-ui::before {
  top: 16px;
  width: 102px;
  height: 116px;
  border: 3px solid #173931;
  border-radius: 6px;
  background:
    linear-gradient(104deg, rgba(230, 255, 220, 0.22) 0 18%, transparent 19%),
    linear-gradient(180deg, rgba(75, 213, 132, 0.36), rgba(9, 68, 46, 0.52)),
    #0b241b;
}

.scan-ui::after {
  bottom: 16px;
  width: 78px;
  height: 50px;
  background:
    radial-gradient(circle at 16px 14px, #d75e58 0 4px, transparent 5px),
    radial-gradient(circle at 62px 14px, #d2d4d0 0 4px, transparent 5px),
    radial-gradient(circle at 39px 36px, #d2d4d0 0 4px, transparent 5px),
    linear-gradient(#33404b, #222b34);
  border-radius: 8px;
}

.scan-alert {
  position: absolute;
  left: 50%;
  top: 42px;
  z-index: 2;
  transform: translateX(-50%);
  color: #bff4ca;
  font-size: 21px;
  font-weight: 900;
  letter-spacing: 0;
  opacity: 0.24;
}

.scan-alert::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -30px;
  width: 28px;
  height: 28px;
  transform: translateX(-50%);
  display: grid;
  place-items: center;
  border: 3px solid currentColor;
  border-radius: 50%;
  font-size: 16px;
}

.scan-wave {
  position: absolute;
  left: 25px;
  right: 25px;
  top: 94px;
  z-index: 2;
  height: 24px;
  opacity: 0.72;
  background: linear-gradient(135deg, transparent 0 12%, #6ff19b 12% 18%, transparent 18% 31%, #6ff19b 31% 37%, transparent 37% 52%, #6ff19b 52% 59%, transparent 59% 72%, #6ff19b 72% 78%, transparent 78%);
  filter: drop-shadow(0 0 4px rgba(83, 232, 129, 0.68));
}

.readout {
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 76px;
  z-index: 3;
  width: auto;
  margin: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: 4px;
}

.readout div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px solid rgba(255, 218, 210, 0.16);
  border-radius: 4px;
  padding: 3px 5px;
  background: rgba(20, 8, 8, 0.5);
  text-align: left;
}

.readout dt {
  color: #ffaaa0;
  font-size: 10px;
}

.readout dd {
  margin: 0;
  color: #ffd9cf;
  font-size: 12px;
  font-weight: 800;
}

.scan-button {
  position: absolute;
  left: 50%;
  top: 58.5%;
  z-index: 12;
  min-width: 82px;
  min-height: 34px;
  transform: translateX(-50%) rotate(1deg);
  border: 1px solid rgba(244, 239, 230, 0.2);
  border-radius: 8px;
  background: linear-gradient(#52606b, #26323c);
  color: #f1f4ee;
  font-size: 14px;
  font-weight: 800;
  box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.05), 0 2px 0 #14191e;
}

.scan-button:disabled {
  opacity: 0.76;
}

.river-found .scan-ui {
  box-shadow: 0 18px 26px rgba(0, 0, 0, 0.4), 0 0 42px rgba(255, 47, 40, 0.56);
}

.river-found .scan-ui::before {
  border-color: #3b1919;
  background:
    linear-gradient(104deg, rgba(255, 221, 199, 0.18) 0 18%, transparent 19%),
    linear-gradient(180deg, rgba(255, 50, 45, 0.32), rgba(80, 0, 0, 0.38)),
    #1a0d0d;
}

.river-found .scan-alert {
  color: #ffd5c9;
}

.river-found .scan-alert::before {
  content: "!";
  border-radius: 0;
  clip-path: polygon(50% 0, 100% 92%, 0 92%);
}

.river-found .scan-wave {
  background: linear-gradient(135deg, transparent 0 12%, #ff6a5f 12% 18%, transparent 18% 31%, #ff6a5f 31% 37%, transparent 37% 52%, #ff6a5f 52% 59%, transparent 59% 72%, #ff6a5f 72% 78%, transparent 78%);
  filter: drop-shadow(0 0 4px rgba(255, 81, 72, 0.86));
}

.river-found .scan-alert,
.river-found .scan-wave {
  opacity: 1;
  animation: alertPulse 520ms steps(2, end) infinite;
}

.river-found [data-meter="signal"] {
  color: #ff6a5f;
}

.river-silenced .anomaly-ripples {
  opacity: 0;
}

.river-silenced .scan-ui {
  box-shadow: 0 18px 26px rgba(0, 0, 0, 0.4), 0 0 30px rgba(95, 209, 129, 0.3);
}

.river-silenced .scan-ui::before {
  border-color: #173931;
  background:
    linear-gradient(104deg, rgba(230, 255, 220, 0.18) 0 18%, transparent 19%),
    linear-gradient(180deg, rgba(66, 177, 107, 0.24), rgba(8, 45, 34, 0.6)),
    #071a14;
}

.river-silenced .scan-alert,
.river-silenced .scan-wave {
  color: #bff4ca;
  animation: none;
  opacity: 0.62;
}

.river-silenced .scan-alert::before {
  content: "";
  border-radius: 50%;
  clip-path: none;
}

.river-silenced .scan-wave {
  background: linear-gradient(135deg, transparent 0 12%, #6ff19b 12% 18%, transparent 18% 31%, #6ff19b 31% 37%, transparent 37% 52%, #6ff19b 52% 59%, transparent 59% 72%, #6ff19b 72% 78%, transparent 78%);
  filter: drop-shadow(0 0 4px rgba(83, 232, 129, 0.52));
}

.river-silenced [data-meter="signal"] {
  color: #8df2a8;
}

[data-scene="river"] .scene-copy {
  position: absolute;
  left: 22px;
  top: 66px;
  z-index: 6;
  max-width: 300px;
}

[data-scene="river"] .scene-copy p {
  color: #fff1d5;
}

[data-scene="river"] .gesture {
  display: none;
}

.memory {
  background:
    radial-gradient(circle at 40% 34%, rgba(217, 180, 95, 0.24), transparent 22%),
    radial-gradient(circle at 60% 54%, rgba(80, 199, 176, 0.22), transparent 26%),
    linear-gradient(#16130f, #0f221f 62%, #12100e);
  overflow: hidden;
}

.memory-stage {
  position: absolute;
  left: 0;
  right: 0;
  top: 12%;
  height: 54%;
  z-index: 5;
}

.memory-card {
  position: absolute;
  inset: 0 26px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 22px;
  opacity: 0;
  transform: translateX(36px) scale(0.96);
  transition: opacity 360ms ease, transform 360ms ease;
}

.memory-card.active {
  opacity: 1;
  transform: translateX(0) scale(1);
}

.memory-card p {
  margin: 0;
  color: #f4efe6;
  font-size: clamp(28px, 7vw, 40px);
  font-weight: 800;
}

.hologram {
  width: min(58vw, 270px);
  aspect-ratio: 1;
  border: 1px solid rgba(80, 199, 176, 0.44);
  border-radius: 50%;
  background:
    linear-gradient(rgba(80, 199, 176, 0.16) 1px, transparent 1px),
    radial-gradient(circle, rgba(80, 199, 176, 0.24), rgba(80, 199, 176, 0.04) 56%, transparent 57%);
  background-size: 100% 12px, auto;
  box-shadow: 0 0 58px rgba(80, 199, 176, 0.28);
}

.salt-icon {
  clip-path: polygon(10% 72%, 88% 36%, 92% 48%, 16% 84%);
}

.train-icon {
  border-radius: 16px;
  clip-path: polygon(16% 34%, 84% 34%, 92% 56%, 82% 70%, 18% 70%, 8% 56%);
}

.city-icon {
  clip-path: polygon(14% 72%, 14% 42%, 28% 42%, 28% 24%, 42% 24%, 42% 54%, 54% 54%, 54% 34%, 70% 34%, 70% 18%, 84% 18%, 84% 72%);
}

.fish-icon {
  clip-path: polygon(12% 50%, 34% 30%, 72% 34%, 92% 18%, 82% 50%, 92% 82%, 72% 66%, 34% 70%);
}

.memory-steps {
  position: absolute;
  left: 50%;
  top: 68%;
  z-index: 8;
  display: flex;
  gap: 9px;
  transform: translateX(-50%);
}

.memory-dot {
  width: 28px;
  height: 3px;
  background: rgba(244, 239, 230, 0.24);
}

.memory-dot.active {
  background: var(--gold);
}

.salt {
  background:
    linear-gradient(transparent 55%, rgba(255, 255, 255, 0.14) 55% 56%, transparent 56%),
    repeating-linear-gradient(0deg, transparent 0 42px, rgba(244, 239, 230, 0.13) 42px 43px),
    linear-gradient(#2b2019, #433522 50%, #17110e);
}

.salt-field {
  position: absolute;
  left: -20%;
  right: -20%;
  bottom: 15%;
  height: 38%;
  transform: perspective(420px) rotateX(62deg);
  background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.25) 0 2px, transparent 2px 46px);
}

.uncle {
  position: absolute;
  left: 16%;
  bottom: 30%;
  width: 86px;
  height: 168px;
  z-index: 4;
}

.uncle-face {
  width: 54px;
  height: 54px;
  margin: 0 auto;
  border-radius: 50%;
  background: #c89467;
}

.uncle-body {
  width: 86px;
  height: 112px;
  margin-top: 2px;
  border-radius: 10px 10px 6px 6px;
  background: #3a2b22;
}

.shell-lamp {
  position: absolute;
  right: 18%;
  bottom: 35%;
  width: 112px;
  height: 76px;
  border-radius: 50% 50% 10px 10px;
  background: repeating-radial-gradient(ellipse at center, #e7d8b7 0 8px, #a4875b 8px 10px);
  transition: box-shadow 800ms ease, filter 800ms ease;
}

.salt-lit .shell-lamp {
  filter: brightness(1.35);
  box-shadow: 0 0 70px rgba(241, 213, 144, 0.9);
}

.dialog {
  position: absolute;
  left: 22px;
  right: 22px;
  top: 22%;
  z-index: 8;
  padding: 14px 16px;
  border-radius: 8px;
  background: rgba(17, 16, 15, 0.76);
  opacity: 0;
  transition: opacity 500ms ease;
}

.salt-lit .dialog {
  opacity: 1;
}

.pollution {
  background:
    radial-gradient(circle at 50% 40%, rgba(217, 180, 95, 0.28), transparent 22%),
    linear-gradient(#120f0e, #201915);
}

#fogCanvas {
  position: absolute;
  inset: 0;
  z-index: 10;
  width: 100%;
  height: 100%;
  touch-action: none;
}

.core {
  position: absolute;
  left: 50%;
  top: 42%;
  width: 178px;
  height: 178px;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, #fff4bd 0 18%, #d9b45f 19% 44%, rgba(80, 199, 176, 0.38) 45% 72%, transparent 73%);
  box-shadow: 0 0 58px rgba(217, 180, 95, 0.46);
}

.finale {
  background:
    radial-gradient(circle at 50% 42%, rgba(80, 199, 176, 0.3), transparent 28%),
    linear-gradient(#071716, #15110d 76%);
}

.chip-target {
  position: absolute;
  left: 50%;
  top: 43%;
  width: 154px;
  height: 154px;
  transform: translate(-50%, -50%);
  border: 2px dashed rgba(241, 213, 144, 0.64);
  border-radius: 50%;
  box-shadow: inset 0 0 32px rgba(217, 180, 95, 0.2);
}

.chip {
  position: absolute;
  z-index: 12;
  width: 74px;
  height: 74px;
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 10px;
  background: linear-gradient(135deg, #f1d590, #a76d36);
  color: #1a1008;
  font-weight: 800;
  touch-action: none;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.22);
}

.chip-one {
  left: 12%;
  top: 25%;
}

.chip-two {
  right: 12%;
  top: 27%;
}

.chip-three {
  left: 42%;
  top: 64%;
}

.chip.locked {
  opacity: 0.7;
  pointer-events: none;
}

.whale {
  position: absolute;
  left: 50%;
  top: 39%;
  z-index: 4;
  width: 280px;
  height: 142px;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.7);
  transition: opacity 900ms ease, transform 900ms ease;
}

.whale-body {
  position: absolute;
  left: 0;
  top: 28px;
  width: 224px;
  height: 92px;
  border-radius: 58% 46% 46% 58%;
  background: radial-gradient(circle at 28% 30%, #fff8d7, #61d1bd 32%, #176b63 78%);
  box-shadow: 0 0 80px rgba(80, 199, 176, 0.76);
}

.whale-tail {
  position: absolute;
  right: 0;
  top: 26px;
  width: 94px;
  height: 94px;
  background: #61d1bd;
  clip-path: polygon(20% 50%, 100% 0, 76% 50%, 100% 100%);
  filter: drop-shadow(0 0 26px rgba(80, 199, 176, 0.82));
}

.finale-complete .whale {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.release-button {
  position: absolute;
  left: 50%;
  top: 59%;
  z-index: 24;
  min-width: 132px;
  min-height: 48px;
  transform: translateX(-50%);
  border: 1px solid rgba(244, 239, 230, 0.24);
  border-radius: 8px;
  background: #50c7b0;
  color: #071716;
  font-weight: 800;
}

.whale-released .whale {
  opacity: 0;
  transform: translate(86%, -78%) scale(0.82);
  transition: opacity 1200ms ease 400ms, transform 1800ms ease;
}

.whale-released .chip-target,
.whale-released .chip {
  opacity: 0;
  transition: opacity 500ms ease;
}

.whale-released {
  background:
    radial-gradient(circle at 50% 30%, rgba(244, 239, 230, 0.2), transparent 18%),
    linear-gradient(#12332f, #0f2a28 46%, #15110d);
}

.ending-line {
  position: absolute;
  left: 20px;
  right: 20px;
  top: 54%;
  z-index: 20;
  text-align: center;
  opacity: 0;
  transition: opacity 900ms ease 600ms;
}

.ending-line strong,
.ending-line span,
.ending-line em {
  display: block;
}

.ending-line strong {
  font-size: clamp(30px, 8vw, 44px);
  line-height: 1.05;
}

.ending-line span {
  margin-top: 12px;
  color: #f1d590;
  font-size: 18px;
  font-weight: 800;
}

.ending-line em {
  margin: 28px auto 0;
  max-width: 320px;
  color: #f4efe6;
  font-size: 20px;
  font-style: normal;
  line-height: 1.45;
}

.whale-released .ending-line {
  opacity: 1;
}

@keyframes waterMove {
  from {
    background-position: 0 0, 0 0, 0 0;
  }
  to {
    background-position: 0 120px, 0 0, 0 0;
  }
}

@keyframes abnormalRipple {
  from {
    inset: 38%;
    opacity: 0.95;
    transform: rotate(0deg);
  }
  to {
    inset: -10%;
    opacity: 0;
    transform: rotate(18deg);
  }
}

@keyframes alertPulse {
  50% {
    filter: brightness(1.8);
  }
}

@keyframes radarSweep {
  to {
    transform: rotate(360deg);
  }
}

@media (min-width: 700px) {
  body {
    display: grid;
    place-items: center;
    background: #191816;
  }

  .phone {
    height: min(92svh, 900px);
    min-height: 760px;
    border: 1px solid rgba(244, 239, 230, 0.14);
  }
}
